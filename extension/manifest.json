{
  "manifest_version": 3,
  "name": "ResumeCraft AutoApply",
  "version": "0.1.0",
  "description": "在招聘平台一键填充简历信息",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://boss.zhipin.com/*",
    "https://www.zhaopin.com/*",
    "https://www.liepin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boss.zhipin.com/*",
        "https://www.zhaopin.com/*",
        "https://www.liepin.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
